# Bahn-Pinneberg.de. Das Repo-Wurzelverzeichnis ist das Web-Root.
RewriteEngine On

# www entfernen und dabei gleich auf HTTPS gehen
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# HTTPS erzwingen
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Security-Header fuer alle Antworten. Die Content-Security-Policy setzen die
# PHP-Seiten selbst (inc/security.php), weil sie eine Nonce je Antwort braucht.
<IfModule mod_headers.c>
	Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Fehlerseiten im Design der Seite (seiten/fehler.php). Der Statuscode bleibt der
# des Fehlers; unter /api/ und /mcp antwortet dieselbe Datei mit JSON.
ErrorDocument 400 /seiten/fehler.php
ErrorDocument 401 /seiten/fehler.php
ErrorDocument 403 /seiten/fehler.php
ErrorDocument 404 /seiten/fehler.php
ErrorDocument 405 /seiten/fehler.php
ErrorDocument 410 /seiten/fehler.php
ErrorDocument 429 /seiten/fehler.php
ErrorDocument 500 /seiten/fehler.php
ErrorDocument 502 /seiten/fehler.php
ErrorDocument 503 /seiten/fehler.php
ErrorDocument 504 /seiten/fehler.php

# ---------- Aufbau ----------
# Oeffentlich liegen nur assets/ (CSS, JS, Schriften, Bilder) und api/ (Endpunkte).
# Seiten stehen in seiten/, Bibliotheken und Bausteine in inc/; beide sind nur ueber
# die Regeln unten erreichbar. Die Adressen der Seiten bleiben dabei unveraendert.
# dev/router.php bildet diese Regeln fuer den eingebauten PHP-Server nach.

# Startseite und Seiten: /faq/ -> seiten/faq.php, /faq und /faq/index.php -> /faq/
RewriteRule ^$ seiten/start.php [L]
RewriteRule ^index\.php$ / [R=301,L]
RewriteRule ^(aktuell|changelog|eilmeldungen|einstellungen|faq|impressum|karte|mcp-hilfe|news|nutzungsbedingungen|statistik|stoerungen)(/index\.php)?$ /$1/ [R=301,L]
RewriteRule ^(aktuell|changelog|eilmeldungen|einstellungen|faq|impressum|karte|mcp-hilfe|news|nutzungsbedingungen|statistik|stoerungen)/$ seiten/$1.php [L]

# Ereignisseiten mit Kennung und lesbarem Zusatz
RewriteRule ^stoerung/([A-Za-z0-9_.-]+)(?:/([a-z0-9-]*))?/?$ seiten/stoerung.php?key=$1&slug=$2 [L,QSA]
RewriteRule ^eilmeldung/([A-Za-z0-9_.-]+)(?:/([a-z0-9-]*))?/?$ seiten/eilmeldung.php?id=$1&slug=$2 [L,QSA]

# Dynamische Textdateien (Adresse aus config.php)
RewriteRule ^sitemap\.xml$ seiten/sitemap.php [L]
RewriteRule ^robots\.txt$ seiten/robots.php [L]
RewriteRule ^llms\.txt$ seiten/llms.php [L]
RewriteRule ^lage\.md$ seiten/lage.php [L]
RewriteRule ^\.well-known/openai-apps-challenge$ seiten/openai-challenge.php [L]

# API: /api/data -> api/data.php; dazu MCP-Server und Verwaltung der Pendlermeldungen
RewriteRule ^api/([a-z0-9-]+)$ api/$1.php [L]
RewriteRule ^mcp/?$ api/mcp.php [L]
RewriteRule ^pendler/verwalten/?$ api/pendler.php?verwalten=1 [L,QSA]

# Dateien mit festen Adressen im Wurzelverzeichnis. Icons und Vorschaubilder auch
# unter ihren alten Adressen (Home-Bildschirm, schon geteilte Links).
RewriteRule ^sw\.js$ assets/js/sw.js [L]
RewriteRule ^manifest\.webmanifest$ assets/manifest.webmanifest [L]
RewriteRule ^favicon\.ico$ assets/icons/favicon.ico [L]
RewriteRule ^(icon-[a-z0-9-]+\.png)$ assets/icons/$1 [L]
RewriteRule ^og/([a-z]+\.png)$ assets/og/$1 [L]
RewriteRule ^(google[0-9a-f]+\.html)$ assets/$1 [L]

# Alles andere gibt es von aussen nicht (404 statt 403, damit nichts verraet, was
# auf dem Server liegt): Verzeichnislisten, versteckte Dateien, Ordner ausser assets/,
# api/ und .well-known/ (cache/, inc/, seiten/, tests/, dev/, Reste wie v2/) und jede
# Datei direkt im Wurzelverzeichnis (config.php, .gitignore, Reste alter Deploys).
# REDIRECT_STATUS ist nur bei der Adresse leer, die der Browser angefragt hat; die
# internen Weiterleitungen der Regeln oben kommen so durch.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^(assets|api)/(.*/)?$ - [R=404,L]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule (^|/)\.(?!well-known/) - [R=404,L]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^(?!(?:assets|api|\.well-known)/)[^/]+/ - [R=404,L]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^[^/]+$ - [R=404,L]


<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
	AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/manifest+json
	AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Der Service Worker muss sich schnell aktualisieren koennen.
<IfModule mod_headers.c>
	<Files "sw.js">
		Header set Cache-Control "no-cache, max-age=0"
	</Files>
</IfModule>

# Statische Dateien einen Monat cachen; Script und Stylesheet tragen einen
# Versionsstempel in der URL und duerfen deshalb laenger im Cache bleiben.
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType image/png "access plus 1 month"
	ExpiresByType image/svg+xml "access plus 1 month"
	ExpiresByType font/woff2 "access plus 1 year"
	ExpiresByType text/css "access plus 1 year"
	ExpiresByType application/javascript "access plus 1 year"
</IfModule>
